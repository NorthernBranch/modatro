{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-zA-Z0-9_@.+ -]+$"
        },
        {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[a-zA-Z0-9_.-]+\\/[a-zA-Z0-9_.-]+$"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "permissions": {
      "type": "object",
      "properties": {
        "display": {
          "type": "boolean"
        },
        "install": {
          "type": "boolean"
        },
        "update": {
          "type": "boolean"
        }
      },
      "required": ["display", "install", "update"],
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "releaseUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceType": {
          "type": "string",
          "enum": ["release-asset", "tag", "commit", "branch", "other"]
        },
        "releaseTag": {
          "type": "string"
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["repository", "releaseUrl"],
      "additionalProperties": false
    },
    "requirements": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[\\w.-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "installation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "mods-directory"
            },
            "folder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-zA-Z0-9_@.+ -]+$"
            },
            "sourceRoot": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": ["type", "folder"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "single-file"
            },
            "folder": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-zA-Z0-9_@.+ -]+$"
            }
          },
          "required": ["type", "folder"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "game-replacement"
            },
            "files": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "destination": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "required": ["source", "destination"],
                "additionalProperties": false
              }
            }
          },
          "required": ["type", "files"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "manual-install-required"
            },
            "instructions": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["type", "instructions"],
          "additionalProperties": false
        }
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "licence": {
      "type": "string",
      "maxLength": 200
    },
    "iconUrl": {
      "type": "string",
      "format": "uri"
    },
    "iconUsageApproved": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "author",
    "version",
    "permissions",
    "distribution",
    "requirements",
    "installation"
  ],
  "additionalProperties": false
}
