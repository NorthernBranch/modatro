{
  "name": "modatro",
  "version": "0.2.0",
  "description": "An independent, safety-first Balatro mod manager",
  "private": true,
  "author": "Modatro contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icon": "node scripts/generate-icon.mjs",
    "check": "prettier --check . && node scripts/compile-catalogue.mjs --check && tsc --noEmit && vitest run && vite build && node scripts/build-electron.mjs",
    "package": "tsc --noEmit && vite build && node scripts/build-electron.mjs && electron-builder",
    "package:dir": "tsc --noEmit && vite build && node scripts/build-electron.mjs && electron-builder --dir",
    "package:desktop": "node scripts/package-desktop.mjs",
    "catalogue:build": "node scripts/compile-catalogue.mjs",
    "catalogue:check": "node scripts/compile-catalogue.mjs --check"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.7.3",
    "yauzl": "^3.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "^7.7.1",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "community.modatro.desktop",
    "productName": "Modatro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "hardenedRuntime": true,
      "identity": "-",
      "notarize": false,
      "entitlements": "build/entitlements.mac.preview.plist",
      "entitlementsInherit": "build/entitlements.mac.preview.plist",
      "artifactName": "Modatro-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Modatro-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": null,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "artifactName": "Modatro-${version}-${arch}.${ext}",
      "maintainer": "Modatro contributors",
      "executableName": "modatro",
      "syncDesktopName": true
    },
    "deb": {
      "compression": "gz"
    }
  },
  "homepage": "https://github.com/NorthernBranch/modatro",
  "desktopName": "modatro.desktop"
}
